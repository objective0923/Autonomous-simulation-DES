{
  "name": "crois-amr-des",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "tsx scripts/dev.ts",
    "dev:web": "vite --host 0.0.0.0",
    "dev:api": "tsx scripts/python.ts -m uvicorn backend.app:app --host 127.0.0.1 --port 8000",
    "start": "tsx scripts/python.ts -m uvicorn backend.app:app --host 127.0.0.1 --port 8000",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "test:e2e": "tsx scripts/browser-smoke.ts && tsx scripts/planning-smoke.ts",
    "test:api": "tsx scripts/python.ts -m pytest",
    "simulate": "tsx scripts/simulate.ts"
  },
  "dependencies": {
    "@fontsource-variable/noto-sans-kr": "5.3.1",
    "pdfjs-dist": "5.4.394",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@sparticuz/chromium": "141.0.0",
    "@types/node": "24.10.0",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "5.1.0",
    "playwright": "1.56.1",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vite": "7.2.2",
    "vitest": "4.0.8"
  }
}
